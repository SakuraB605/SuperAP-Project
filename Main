package home.sj;

import java.awt.Graphics;
import java.util.ArrayList;
import java.awt.Color;
import java.awt.Container;
import javax.swing.JFrame;
import javax.swing.JPanel;

public class Main extends JPanel {
  static Square[][] arr = new Square[65][100];

  public void paintComponent(Graphics g) {
    super.paintComponent(g);

    int j = 0;
    int k = 0;
    int w = 5;

    for (int r = 0; r < arr.length; r++) {
      for (int c = 0; c < arr[0].length; c++) {
        if (arr[r][c] != null) {

          g.setColor(arr[r][c].getColor());
        }
        g.fillRect(20 + j, 40 + k, w, w);
        j += w;

      }
      j = 0;
      k += w;
    }

  }

  public static void main(String[] args) {
    JFrame window = new JFrame("Graphics Demo");

    window.setBounds(100, 100, 900, 800);
    window.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

    Main panel = new Main();
    panel.setBackground(Color.WHITE);
    Container c = window.getContentPane();
    c.add(panel);

    window.setVisible(true);
    // initPuzzle4();
    initializePuzzle();
//    printPuzzle();
    permLists();
// boolean solved = true;
//while (!solved){
//  for (int r = 0; r < arr.length; r++) {
//    for (int c = 0; c < arr[0].length; c++) {
//      if(arr[r][c].isLocked() != true) {
//        solved = false;
//      }
//    }
//  }
//}
    for (int x = 0; x < 600; x++) {
      validPerm();
      lockSquares();
      lonelySquares();
      lonelySquaresPtTwo();
    }

    printFinal();
  }

  private static void printFinal() {
    for (int row = 0; row < arr.length; row++) {
      for (int col = 0; col < arr[0].length; col++) {
        if (arr[row][col] != null && arr[row][col].getNumber() > 0) {
          System.out.println(arr[row][col].getArrayList());
        }
      }
    }

  }

